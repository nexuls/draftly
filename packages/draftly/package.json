{
  "name": "draftly",
  "version": "2.0.0",
  "description": "Core library for draftly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neuronexul/draftly.git",
    "directory": "packages/draftly"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "generate:katex-css": "bun scripts/generate-katex-css.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@turbo/gen": "^2.7.6",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.0.10",
    "@workspace/biome-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@lezer/common": "^1.5.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.3",
    "dompurify": "^3.3.1",
    "katex": "^0.16.28",
    "mermaid": "^11.12.2",
    "node-emoji": "^2.2.0",
    "style-mod": "^4.1.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js",
      "require": "./dist/editor/index.cjs",
      "default": "./dist/editor/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js",
      "require": "./dist/plugins/index.cjs",
      "default": "./dist/plugins/index.js"
    },
    "./plugins/mermaid": {
      "types": "./dist/plugins/mermaid.d.ts",
      "import": "./dist/plugins/mermaid.js",
      "require": "./dist/plugins/mermaid.cjs",
      "default": "./dist/plugins/mermaid.js"
    },
    "./plugins/math": {
      "types": "./dist/plugins/math.d.ts",
      "import": "./dist/plugins/math.js",
      "require": "./dist/plugins/math.cjs",
      "default": "./dist/plugins/math.js"
    },
    "./plugins/emoji": {
      "types": "./dist/plugins/emoji.d.ts",
      "import": "./dist/plugins/emoji.js",
      "require": "./dist/plugins/emoji.cjs",
      "default": "./dist/plugins/emoji.js"
    },
    "./plugins/all": {
      "types": "./dist/plugins/all.d.ts",
      "import": "./dist/plugins/all.js",
      "require": "./dist/plugins/all.cjs",
      "default": "./dist/plugins/all.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "import": "./dist/preview/index.js",
      "require": "./dist/preview/index.cjs",
      "default": "./dist/preview/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs",
      "default": "./dist/lib/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": [
      "./src/*.ts",
      "./src/*"
    ]
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.11"
  }
}
